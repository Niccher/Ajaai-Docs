# Database Configuration
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/ajaia_docs

# MinIO / S3 Object Storage Configuration
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadminpassword
MINIO_BUCKET=ajaia-documents
MINIO_SECURE=false

# Port & Network Settings (Standard HTTP: 80, Dev: 8000)
PORT=80
CORS_ORIGINS=*

# App Settings
APP_ENV=production
